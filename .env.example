# ------------------------------------------------------------------------------
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored — NEVER commit it. These are PLACEHOLDERS, not real secrets.
# ------------------------------------------------------------------------------

# --- Application ---
# Host port the API is published on (container port is fixed at 28242).
APP_PORT=28242

# --- MySQL ---
MYSQL_DATABASE=bipLoad
MYSQL_USER=bip
# App DB user password. REQUIRED — compose refuses to start without it.
MYSQL_PASSWORD=change-me-app-db-password
# Root password for the MySQL container. REQUIRED.
MYSQL_ROOT_PASSWORD=change-me-root-password
# Host port MySQL is exposed on for local DB clients (dev override only).
MYSQL_PORT=3306

# --- Dev tools ---
ADMINER_PORT=8081

# --- Observability (only when: docker compose --profile observability up) ---
GRAFANA_ADMIN_USER=admin
# REQUIRED when running the observability profile. No default on purpose.
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# --- Image naming (optional, for pushing to a registry) ---
# IMAGES_PREFIX=ghcr.io/youruser/
# IMAGE_TAG=dev
